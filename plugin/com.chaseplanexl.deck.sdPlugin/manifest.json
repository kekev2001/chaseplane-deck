{
  "SDKVersion": 2,
  "Name": "ChasePlane Deck",
  "Author": "Independent",
  "Description": "Control ChasePlane (Parallel 42) from a Stream Deck (Mini, 15-key, Neo, +, XL, + XL, Studio; a ready-made profile for each) through ChasePlane's local Bridge: cockpit, external and world cameras, the views of the loaded aircraft with live highlighting, cinematic, flashlight and speed. The other keys press the keyboard shortcuts you have set in ChasePlane. Not affiliated with Parallel 42, Elgato or Microsoft.",
  "Category": "ChasePlane",
  "CategoryIcon": "imgs/plugin/category",
  "Icon": "imgs/plugin/icon",
  "Version": "1.1.0.0",
  "CodePath": "bin/plugin.js",
  "Nodejs": {
    "Version": "20"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Software": {
    "MinimumVersion": "6.4"
  },
  "Profiles": [
    {
      "Name": "Profiles/ChasePlane.Standard",
      "DeviceType": 0,
      "Readonly": false,
      "DontAutoSwitchWhenInstalled": true,
      "AutoInstall": true
    },
    {
      "Name": "Profiles/ChasePlane.Mini",
      "DeviceType": 1,
      "Readonly": false,
      "DontAutoSwitchWhenInstalled": true,
      "AutoInstall": true
    },
    {
      "Name": "Profiles/ChasePlane.XL",
      "DeviceType": 2,
      "Readonly": false,
      "DontAutoSwitchWhenInstalled": true,
      "AutoInstall": true
    },
    {
      "Name": "Profiles/ChasePlane.Plus",
      "DeviceType": 7,
      "Readonly": false,
      "DontAutoSwitchWhenInstalled": true,
      "AutoInstall": true
    },
    {
      "Name": "Profiles/ChasePlane.Neo",
      "DeviceType": 9,
      "Readonly": false,
      "DontAutoSwitchWhenInstalled": true,
      "AutoInstall": true
    },
    {
      "Name": "Profiles/ChasePlane.Studio",
      "DeviceType": 10,
      "Readonly": false,
      "DontAutoSwitchWhenInstalled": true,
      "AutoInstall": true
    },
    {
      "Name": "Profiles/ChasePlane.PlusXL",
      "DeviceType": 13,
      "Readonly": false,
      "DontAutoSwitchWhenInstalled": true,
      "AutoInstall": true
    }
  ],
